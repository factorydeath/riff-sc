{
  "name": "riff-sc",
  "version": "42.3.1",
  "main": "main.js",
  "bin": {
    "riff-sc": "./cli.js",
    "riff": "./cli.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "keywords": [
    "soundcloud",
    "soundcloud-client",
    "music-player",
    "material-design-3",
    "audio-player",
    "electron"
  ],
  "author": "factorydeath",
  "license": "MIT",
  "description": "Riff SC - dedicated desktop SoundCloud client and audio suite with Material Design 3.",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "cfonts": "^3.3.1",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.7.1",
    "tone": "^15.1.22"
  },
  "productName": "Riff SC",
  "homepage": "https://github.com/factorydeath/riff-sc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/factorydeath/riff-sc.git"
  },
  "bugs": {
    "url": "https://github.com/factorydeath/riff-sc/issues"
  },
  "build": {
    "appId": "io.github.factorydeath.riff-sc",
    "productName": "Riff SC",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!.github/**",
      "!dist/**",
      "!bin/**",
      "!*.md",
      "!strip_comments.js",
      "!.riff_progress.md",
      "!package-lock.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "factorydeath",
        "repo": "riff-sc",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "yt-dlp.exe",
          "ffmpeg.exe",
          "ffprobe.exe",
          "yt-dlp",
          "ffmpeg",
          "ffprobe"
        ]
      }
    ]
  }
}
